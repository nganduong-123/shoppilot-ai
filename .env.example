GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_PATH=data/shoppilot.db
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Facebook Messenger pilot (keep real values only in .env)
META_SHOP_SLUG=mint-fashion
META_PAGE_ID=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=replace-with-a-long-random-string
META_GRAPH_API_VERSION=v26.0

# Optional Messenger pilot through Make.com
MAKE_BRIDGE_SECRET=replace-with-a-long-random-string
MAKE_MESSENGER_OUTBOUND_WEBHOOK_URL=
