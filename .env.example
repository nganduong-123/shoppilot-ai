APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/shoppilot.db
DATABASE_URL=

AUTH_REQUIRED=false
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PROVIDER=console
EMAIL_FROM=ShopPilot AI <noreply@example.com>
RESEND_API_KEY=
VERIFICATION_TOKEN_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
CHAT_RATE_LIMIT_REQUESTS=60
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CSV_UPLOAD_BYTES=2000000
MAX_CSV_ROWS=10000
SESSION_COOKIE_NAME=shoppilot_session
SESSION_DAYS=14
TOKEN_ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Recommended Messenger onboarding uses the Meta app credentials below.
# Page owners then connect their own Page from ShopPilot's Integrations screen.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Optional legacy single-Page fallback. Leave blank when using Meta OAuth.
META_SHOP_SLUG=mint-fashion
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Optional Make.com bridge.
MAKE_BRIDGE_SECRET=
MAKE_MESSENGER_OUTBOUND_WEBHOOK_URL=

# Optional production bridges. Both requests are signed with this shared secret.
SHIPPING_QUOTE_URL=
COMMERCE_ORDER_WEBHOOK_URL=
INTEGRATION_WEBHOOK_SECRET=
