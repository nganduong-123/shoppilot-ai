APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/shoppilot.db
DATABASE_URL=

AUTH_REQUIRED=false
REGISTRATION_ENABLED=true
SESSION_COOKIE_NAME=shoppilot_session
SESSION_DAYS=14
TOKEN_ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Recommended Messenger onboarding uses the Meta app credentials below.
# Page owners then connect their own Page from ShopPilot's Integrations screen.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Optional legacy single-Page fallback. Leave blank when using Meta OAuth.
META_SHOP_SLUG=mint-fashion
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Optional Make.com bridge.
MAKE_BRIDGE_SECRET=
MAKE_MESSENGER_OUTBOUND_WEBHOOK_URL=
